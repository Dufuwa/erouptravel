rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function isMember(tripId) {
      return signedIn() && request.auth.token.email in tripDoc(tripId).data.memberEmails;
    }

    function isOwner(tripId) {
      return signedIn() && request.auth.token.email == tripDoc(tripId).data.ownerEmail;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.token.email in resource.data.memberEmails;
      allow create, delete: if false;
      allow update: if isMember(tripId)
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.ownerEmail in request.resource.data.memberEmails
        && (
          request.resource.data.memberEmails == resource.data.memberEmails
          || isOwner(tripId)
        );

      match /cities/{cityId} {
        allow read, create, update, delete: if isMember(tripId);
      }

      match /days/{dayId} {
        allow read, create, update, delete: if isMember(tripId);

        match /places/{placeId} {
          allow read, create, update, delete: if isMember(tripId);
        }

        match /transports/{transportId} {
          allow read, create, update, delete: if isMember(tripId);
        }
      }

      match /todos/{todoId} {
        allow read, create, update, delete: if isMember(tripId);
      }

      match /accommodations/{accommodationId} {
        allow read, create, update, delete: if isMember(tripId);
      }

      match /transportBookings/{bookingId} {
        allow read, create, update, delete: if isMember(tripId);
      }

      match /tickets/{ticketId} {
        allow read, create, update, delete: if isMember(tripId);
      }
    }
  }
}
